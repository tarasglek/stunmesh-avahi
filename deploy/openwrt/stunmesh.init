#!/bin/sh /etc/rc.common
# stunmesh-go for the wgmesh WireGuard interface (stunmesh-avahi bundle).
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/local/bin/stunmesh-go -c /etc/stunmesh/config.yaml
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# stunmesh reads the device once at startup; restart it when netifd brings
# wgmesh up again (new interface, possibly new state).
service_triggers() {
	procd_add_interface_trigger "interface.*.up" wgmesh /etc/init.d/stunmesh restart
}
